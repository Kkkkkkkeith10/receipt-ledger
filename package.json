{
	"name": "receipt-ledger",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"dev:all": "concurrently -n VITE,CF -c auto,auto \"pnpm:dev\" \"pnpm:dev:cf\"",
		"dev:cf": "wrangler dev --persist-to .wrangler/state",
		"dev:cf:remote": "wrangler dev --remote",
		"build": "vite build",
		"deploy": "pnpm build && wrangler deploy",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"seed:receipts": "tsx data/seed-receipts.ts",
		"test:unit": "tsx tests/unit-tests.ts",
		"test:infra": "tsx tests/infrastructure-test.ts",
		"test:remote": "tsx tests/cloudflare-remote-test.ts",
		"test:direct": "tsx tests/direct-cloudflare-test.ts",
		"test:ai": "tsx tests/ai-receipt-tests.ts",
		"test:ai:unit": "tsx tests/ai-unit-tests.ts",
		"test:ai:integration": "tsx tests/ai-integration-tests.ts",
		"test:ai:connection": "tsx tests/ai-connection-test.ts",
		"test:ai:invoices": "tsx tests/test-all-invoices.ts",
		"test:ai:all": "pnpm test:ai:unit && pnpm test:ai:connection && pnpm test:ai:invoices",
		"test:receipts": "tsx tests/test-receipt-direct.ts",
		"generate:invoices": "tsx tests/generate-pdfs.ts",
		"cleanup:all": "tsx scripts/cleanup-all-data.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^3.2.4",
		"@sveltejs/adapter-cloudflare": "^7.2.3",
		"@sveltejs/kit": "^2.5.28",
		"@sveltejs/vite-plugin-svelte": "^3.0.0",
		"@types/node": "^22.7.4",
		"@vite-pwa/sveltekit": "^1.1.0",
		"autoprefixer": "^10.4.20",
		"axios": "^1.13.2",
		"concurrently": "^8.2.2",
		"dotenv": "^17.2.3",
		"form-data": "^4.0.5",
		"postcss": "^8.4.41",
		"sharp": "^0.34.5",
		"svelte": "^4.2.7",
		"svelte-check": "^3.6.0",
		"tailwindcss": "^3.4.9",
		"tsx": "^4.19.1",
		"typescript": "^5.0.0",
		"vite": "^5.0.3",
		"vite-plugin-pwa": "^1.2.0",
		"workbox-window": "^7.4.0",
		"wrangler": "^4.33.1"
	},
	"type": "module",
	"dependencies": {
		"@auth/core": "0.41.1",
		"@auth/sveltekit": "^1.11.1",
		"@aws-sdk/client-s3": "^3.879.0",
		"@aws-sdk/s3-request-presigner": "^3.879.0",
		"@cloudflare/workers-types": "^4.20250831.0",
		"@libsql/client": "^0.14.0",
		"@llamaindex/azure": "^0.2.0",
		"chart.js": "^4.4.0",
		"drizzle-kit": "^0.31.4",
		"drizzle-orm": "^0.44.5",
		"llamaindex": "^0.12.1",
		"lucia": "^3.2.2",
		"nanoid": "^5.1.5",
		"node-poppler": "^9.0.1",
		"openai": "^4.77.0",
		"pdf-lib": "^1.17.1",
		"pdfjs-dist": "^5.4.530",
		"undici": "^6.19.8",
		"zod": "^4.1.5"
	}
}