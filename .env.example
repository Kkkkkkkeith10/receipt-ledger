# Example Environment Configuration
# Copy this to .env and fill in your actual values

# Auth.js Configuration
# Generate a secret: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# Azure OpenAI Configuration (for OCR features)
# Get these from your Azure OpenAI resource in the Azure Portal
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_KEY=your-32-character-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4-vision-preview

# Cloudflare Configuration (optional for local development)
# Get these from your Cloudflare dashboard
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# Development Settings
NODE_ENV=development

# Scripts and tests (local only)
SEED_USER_PASSWORD=
NEW_USER_EMAIL=
NEW_USER_PASSWORD=
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=
