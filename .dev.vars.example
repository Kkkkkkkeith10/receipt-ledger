# Local development environment variables
# Copy this file to .dev.vars and fill in your values
# These values are used when running `wrangler dev`

# Auth.js secret - REQUIRED for authentication
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here

# Azure OpenAI Configuration (same as aiv4)
# Get these from Azure Portal > Azure OpenAI > Keys and Endpoint
AZURE_FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_FOUNDRY_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
